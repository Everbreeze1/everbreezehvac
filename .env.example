# Supabase (your own project, not Lovable Cloud). Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lead alert emails via Resend (resend.com). The from-address domain must be verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Everbreeze Website <leads@everbreezehvac.com>"
LEAD_ALERT_EMAIL=contact@everbreezehvac.com

# Optional: add bookings to the Google Calendar that Markate syncs from.
# A Google Cloud service account JSON key (one line), with the calendar shared to its email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_JSON=
LEADS_CALENDAR_ID=

# Optional: live Google reviews (Places API (New)).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
